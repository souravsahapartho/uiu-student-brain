# ==============================================================================
# STUDENTBRAIN ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=dev-secret-key-studentbrain-insecure-replace-in-prod
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Database Configuration
POSTGRES_DB=student_brain
POSTGRES_USER=student_brain
POSTGRES_PASSWORD=rafayet150903
# Use 'db' when running in Docker, 'localhost' when running standalone
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Google Gemini AI Service API Key
# (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=

# Google OAuth / Institutional SSO Configuration
GOOGLE_CLIENT_ID=97595115320-as37nh6t3kp0tgdgsad4o1jri6k5tmr6.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=97595115320-as37nh6t3kp0tgdgsad4o1jri6k5tmr6.apps.googleusercontent.com

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api

# Database Seeding on Container Boot (true/false)
AUTO_SEED=true

